---
import Layout from '../../layouts/Layout.astro';
import { CheckCircle } from "@phosphor-icons/react/dist/ssr";
import { allModels } from "../../utils/data";

export function getStaticPaths() {
    return allModels.map(m => ({ params: { id: m.id } }));
}

const { id } = Astro.params;
const model = allModels.find(m => m.id === id);
if (!model) return Astro.redirect('/404');

const canonicalUrl = import.meta.env.CANONICAL_URL || "http://localhost:4321";
---

<Layout>
    <!-- Breadcrumb / back -->
    <section class="bg-jmso-dark-blue text-white py-12 md:py-14 px-6">
        <div class="container w-full">
            <a
                href="/#our-products"
                class="inline-flex items-center gap-2 text-sm text-jmso-tosca hover:text-white transition-colors mb-6"
            >
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                </svg>
                Back to Products
            </a>
            <p class="text-jmso-tosca text-lg lg:text-xl font-semibold uppercase tracking-wider mb-2">{model.productTitle}</p>
            <h1 class="text-2xl lg:text-3xl font-bold">{model.model}</h1>
        </div>
    </section>

    <!-- Model detail -->
    <section class="bg-jmso-light-blue py-12 px-6">
        <div class="container w-full">
            <div class="bg-white rounded-2xl overflow-hidden shadow-md border-2 border-gray-200 grid md:grid-cols-[400px,1fr]">
                <!-- Image - Smaller Fixed Width -->
                <div class="bg-gradient-to-br from-gray-50 to-gray-100 p-6 md:p-8 border-b-2 md:border-b-0 md:border-r-2 border-gray-200 flex items-center">
                    <!-- Image Container - Compact Size -->
                    <div class="relative group">
                        <div class="aspect-square bg-white rounded-xl shadow-sm overflow-hidden max-w-sm mx-auto">
                            <img 
                                src={model.productImg.src} 
                                alt={model.model} 
                                class="w-full h-full object-contain p-4 transition-transform duration-500 group-hover:scale-105 zoom-trigger"
                            />
                            <!-- Zoom Button -->
                            <button
                                class="zoom-button absolute top-3 right-3 bg-white/90 backdrop-blur-sm p-2 rounded-full shadow-md opacity-0 group-hover:opacity-100 transition-all duration-300 hover:bg-white hover:scale-110"
                                aria-label="Zoom image"
                            >
                                <svg class="w-4 h-4 text-jmso-dark-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/>
                                </svg>
                            </button>
                        </div>

                        <!-- Product Code Badge - Compact -->
                        <div class="mt-5 text-jmso-dark-blue text-center">
                            <p class="text-lg md:text-xl font-bold">{model.model}</p>
                        </div>
                    </div>
                </div>

                <!-- Specs -->
                <div class="p-6 md:p-8">
                    <div class="mb-6">
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-1 h-6 bg-jmso-tosca rounded-full"></div>
                            <h2 class="text-xl md:text-2xl font-bold text-jmso-dark-blue">Technical Specifications</h2>
                        </div>
                    </div>

                    <ul class="space-y-3 mb-8">
                        {model.features.map(f => (
                            <li class="flex items-start gap-3 text-base text-gray-700 leading-relaxed group">
                                <CheckCircle 
                                    size={18} 
                                    weight="fill" 
                                    className="text-jmso-tosca mt-0.5 flex-shrink-0 group-hover:scale-110 transition-transform" 
                                    client:load 
                                />
                                <span class="group-hover:text-gray-900 transition-colors">{f}</span>
                            </li>
                        ))}
                    </ul>
                    <a
                        href="https://wa.me/6282139940054"
                        class="text-lg inline-flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white py-3 px-6 rounded-xl font-semibold transition-all duration-300 shadow-md hover:shadow-lg"
                    >
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                        Contact Sales
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Image Zoom Modal -->
    <div id="zoom-modal" class="fixed inset-0 bg-black/90 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
        <button
            id="close-zoom"
            class="absolute top-4 right-4 text-white hover:bg-white/20 p-2 rounded-full transition-colors"
            aria-label="Close zoom"
        >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
        <div class="relative max-w-4xl w-full bg-white rounded-xl p-4">
            <img 
                id="zoomed-image"
                src={model.productImg.src} 
                alt={model.model}
                class="w-full h-auto object-contain max-h-[80vh]"
            />
            <p class="text-center mt-3 text-gray-700 font-semibold text-sm">
                {model.model}
            </p>
        </div>
    </div>

    <style>
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes scaleIn {
            from { 
                opacity: 0;
                transform: scale(0.95);
            }
            to { 
                opacity: 1;
                transform: scale(1);
            }
        }

        #zoom-modal {
            animation: fadeIn 0.2s ease-out;
        }

        #zoom-modal > div {
            animation: scaleIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
    </style>

    <script>
        // Zoom functionality
        const zoomButtons = document.querySelectorAll('.zoom-button');
        const zoomModal = document.getElementById('zoom-modal');
        const closeZoomBtn = document.getElementById('close-zoom');

        zoomButtons.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                zoomModal?.classList.remove('hidden');
                zoomModal?.classList.add('flex');
            });
        });

        closeZoomBtn?.addEventListener('click', () => {
            zoomModal?.classList.add('hidden');
            zoomModal?.classList.remove('flex');
        });

        zoomModal?.addEventListener('click', (e) => {
            if (e.target === zoomModal) {
                zoomModal.classList.add('hidden');
                zoomModal.classList.remove('flex');
            }
        });

        // Prevent click propagation on modal content
        const modalContent = zoomModal?.querySelector('div');
        modalContent?.addEventListener('click', (e) => {
            e.stopPropagation();
        });
    </script>
</Layout>